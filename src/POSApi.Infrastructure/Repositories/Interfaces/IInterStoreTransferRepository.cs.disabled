using POSApi.Domain.Entities;
using POSApi.Domain.Repositories;

namespace POSApi.Infrastructure.Repositories.Interfaces;

public interface IInterStoreTransferRepository : IRepository<InterStoreTransfer>
{
    Task<InterStoreTransfer?> GetByTransferNumberAsync(string transferNumber, CancellationToken cancellationToken = default);
    Task<List<InterStoreTransfer>> GetByStoreAsync(Guid storeId, CancellationToken cancellationToken = default);
    Task<List<InterStoreTransfer>> GetByStatusAsync(InterStoreTransferStatus status, CancellationToken cancellationToken = default);
    Task<InterStoreTransfer?> GetWithItemsAsync(Guid id, CancellationToken cancellationToken = default);
}
